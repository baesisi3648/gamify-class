{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "class-manitto",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class-manitto",
      "database_id": "082b9e03-e136-49e9-b2c2-92cec9f79c58",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "class-manitto-photos"
    }
  ]
}
